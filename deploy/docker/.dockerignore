# Files NOT to send to the Docker build context.
# Keeps the build context small and prevents secrets / dev junk
# from leaking into the image.

# Version control
.git
.gitignore
.gitattributes

# Python build artifacts
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
.eggs
dist
build
*.egg

# Virtual environments
.venv
venv
env

# Test / coverage artifacts
.pytest_cache
.coverage
htmlcov
.tox
.nox

# Type checker caches
.mypy_cache
.pyrefly_cache
.ruff_cache
.ty_cache

# IDE
.idea
.vscode
*.swp
.DS_Store

# Docs build output
docs/_build
site

# Local data / dev DBs
data
*.db
*.sqlite
*.sqlite3

# Secrets / config that shouldn't be in images
.env
.env.*
*.pem
*.key

# Notes — not needed at runtime
notes
sandbox

# Tests — not needed at runtime
tests
